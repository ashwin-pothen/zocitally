{
  "name": "zotero-zocitally",
  "version": "0.3.0",
  "private": true,
  "description": "Citation counts for Zotero, powered by OpenAlex.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "package": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
